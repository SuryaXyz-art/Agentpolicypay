{
    "name": "apolo-mind",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "dev": "node -r dotenv/config ./node_modules/next/dist/bin/next dev frontend",
        "build": "node -r dotenv/config ./node_modules/next/dist/bin/next build frontend",
        "start": "node -r dotenv/config ./node_modules/next/dist/bin/next start frontend",
        "lint": "eslint frontend --max-warnings=0",
        "typecheck": "tsc --noEmit",
        "compile": "hardhat compile",
        "coverage": "hardhat coverage",
        "deploy:0g": "hardhat run scripts/deploy.ts --network og",
        "preflight:aristotle": "hardhat run scripts/preflight.ts --network aristotle",
        "deploy:aristotle": "hardhat run scripts/deploy.ts --network aristotle",
        "verify:aristotle": "hardhat run scripts/verify-deployment.ts --network aristotle",
        "deploy:rehearsal": "hardhat run scripts/deploy.ts --network hardhat",
        "test": "hardhat test"
    },
    "dependencies": {
        "@0gfoundation/0g-storage-ts-sdk": "1.2.11",
        "@rainbow-me/rainbowkit": "^2.2.8",
        "@tanstack/react-query": "^5.62.11",
        "ethers": "6.13.1",
        "lucide-react": "^0.468.0",
        "next": "^15.1.3",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "viem": "^2.21.58",
        "wagmi": "^2.14.7"
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-toolbox": "5.0.0",
        "@nomicfoundation/hardhat-chai-matchers": "2.0.8",
        "@nomicfoundation/hardhat-ethers": "3.0.8",
        "@nomicfoundation/hardhat-ignition": "0.15.7",
        "@nomicfoundation/hardhat-ignition-ethers": "0.15.7",
        "@nomicfoundation/hardhat-network-helpers": "1.0.12",
        "@nomicfoundation/hardhat-verify": "2.0.1",
        "@nomicfoundation/ignition-core": "0.15.7",
        "@openzeppelin/contracts": "5.0.2",
        "@typechain/ethers-v6": "^0.5.1",
        "@typechain/hardhat": "^9.1.0",
        "@types/chai": "^4.3.20",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.10.5",
        "@types/react": "^19.0.2",
        "@types/react-dom": "^19.0.2",
        "autoprefixer": "^10.5.0",
        "chai": "^4.5.0",
        "dotenv": "^16.6.1",
        "eslint": "^9.17.0",
        "eslint-config-next": "^15.1.3",
        "hardhat": "2.28.6",
        "hardhat-gas-reporter": "^1.0.10",
        "postcss": "^8.5.15",
        "solidity-coverage": "^0.8.17",
        "tailwindcss": "^3.4.19",
        "ts-node": "10.9.2",
        "typechain": "^8.3.2",
        "typescript": "^5.7.2"
    }
}
